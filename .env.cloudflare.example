# Copy to .env.cloudflare. Never commit the completed file.
# Production is local Docker + the EXISTING Cloudflare Tunnel.
MPAY_BACKEND_IMAGE=ghcr.io/manav326/mpay-backend
MPAY_ADMIN_WEB_IMAGE=ghcr.io/manav326/mpay-admin-web
# The deployment script replaces these with immutable tags from main.
MPAY_IMAGE_TAG=sha-REPLACED_BY_DEPLOY_SCRIPT
MPAY_ADMIN_WEB_TAG=azure-sha-REPLACED_BY_DEPLOY_SCRIPT

MPAY_DB_NAME=recharge
MPAY_DB_USERNAME=recharge
MPAY_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS

# Public web/API domains already selected for mPay.
MPAY_WEB_API_BASE_URL=https://api.mpay.thinkwithsujeet.in
MPAY_CORS_ALLOWED_ORIGINS=https://mpay.thinkwithsujeet.in
MPAY_BACKEND_BIND_ADDRESS=127.0.0.1
MPAY_ADMIN_WEB_BIND_ADDRESS=127.0.0.1
MPAY_BACKEND_HOST_PORT=18080
MPAY_ADMIN_WEB_HOST_PORT=13000

# Production must never simulate payment or payout success.
MPAY_PAYMENT_GATEWAY_PROVIDERS=razorpay,payu
MPAY_PAYMENT_MOCK_ENABLED=false
MPAY_WITHDRAWAL_PROVIDER_ORDER=razorpay,payu
MPAY_WITHDRAWAL_MOCK_ENABLED=false
MPAY_AUTH_OTP_PROVIDER=way2api
MPAY_RECHARGE_OPERATOR_PROVIDERS=payu,way2api
MPAY_RECHARGE_PLAN_PROVIDERS=payu,way2api
MPAY_RECHARGE_EXECUTION_PROVIDERS=payu

# Obtain these values from the approved live PayU account/configuration.
# Do not substitute UAT/sandbox endpoints or credentials.
MPAY_PAYU_ENVIRONMENT=REPLACE_WITH_production
MPAY_PAYU_AUTH_BASE_URL=https://REPLACE_WITH_APPROVED_LIVE_PAYU_AUTH_HOST
MPAY_PAYU_NBC_BASE_URL=https://REPLACE_WITH_APPROVED_LIVE_PAYU_NBC_HOST
MPAY_PAYU_AGENT_ID=REPLACE_WITH_APPROVED_LIVE_AGENT_ID
MPAY_PAYU_PG_VERIFY_URL=https://REPLACE_WITH_APPROVED_LIVE_PAYU_VERIFY_HOST/path
MPAY_PAYU_PG_SUCCESS_URL=https://REPLACE_WITH_APPROVED_SUCCESS_CALLBACK
MPAY_PAYU_PG_FAILURE_URL=https://REPLACE_WITH_APPROVED_FAILURE_CALLBACK
MPAY_PAYU_PG_PRODUCTION=true

# Enable only after the respective payout provider has been approved and tested.
MPAY_RAZORPAY_PAYOUT_ENABLED=false
MPAY_PAYU_PAYOUT_ENABLED=false
MPAY_PAYU_PAYOUT_ENVIRONMENT=production

# Optional capabilities. Voice media still requires an independently reachable TURN service.
MPAY_SUPPORT_AI_PROVIDER_ENABLED=false
MPAY_FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
MPAY_CALL_ICE_SERVERS=stun:stun.l.google.com:19302,turn:REPLACE_WITH_PUBLIC_TURN_HOST:3478?transport=udp,turn:REPLACE_WITH_PUBLIC_TURN_HOST:3478?transport=tcp
MPAY_CALL_TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
MPAY_CALL_TURN_CREDENTIAL=REPLACE_WITH_LONG_RANDOM_TURN_CREDENTIAL
