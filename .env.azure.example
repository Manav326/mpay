# Azure VM deployment environment.
# Copy this file to .env on the VM and replace the placeholders.
#
# The VM deployment uses PostgreSQL in Docker; no Azure-managed PostgreSQL is required.

MPAY_BACKEND_IMAGE=ghcr.io/manav326/mpay-backend
MPAY_ADMIN_WEB_IMAGE=ghcr.io/manav326/mpay-admin-web

# Image tags are derived automatically by scripts/mpay-azure-deploy.ps1
# from the synchronized Git commit. Do not manually maintain commit SHA tags.

MPAY_DB_NAME=recharge
MPAY_DB_USERNAME=recharge
MPAY_DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Public web/API/CORS/TURN names are derived from config/public-hosts.env.
# Do not duplicate public hostnames in this secret-bearing environment file.

MPAY_RENTAL_PLATFORM_FEE_PERCENT=10.00

# OpenAI Customer Care AI provider. Provider configuration does not itself expose AI to customers.
# An Admin must enable the Customer Care AI switch in Admin -> Customer Care.
MPAY_SUPPORT_AI_PROVIDER_ENABLED=true
MPAY_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
MPAY_SUPPORT_AI_MODEL=gpt-5.6-luna
# Optional OpenAI vector store containing the authoritative mPay support knowledge pack.
MPAY_SUPPORT_AI_VECTOR_STORE_ID=

# Firebase Admin service-account credential for FCM.
# Store the single-line Base64 encoding of the JSON on the Azure VM.
MPAY_FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=REPLACE_WITH_BASE64_FIREBASE_SERVICE_ACCOUNT

# Voice calling / TURN. These values stay only on the Azure VM.
# TURN realm and ICE host are generated from config/public-hosts.env.
MPAY_CALL_TURN_EXTERNAL_IP=REPLACE_WITH_AZURE_PUBLIC_IP
MPAY_CALL_TURN_USERNAME=mpay-turn
MPAY_CALL_TURN_CREDENTIAL=REPLACE_WITH_LONG_RANDOM_TURN_PASSWORD

# Keep application services private to the VM; Caddy is the only public entry point for HTTP.
MPAY_BACKEND_BIND_ADDRESS=127.0.0.1
MPAY_ADMIN_WEB_BIND_ADDRESS=127.0.0.1
