# LOCAL DEVELOPMENT / DEPLOYMENT SECRET CONFIGURATION
# Keep this file outside version control. Use the same external-file shape in production.
app:
  auth:
    password-reset:
      otp-ttl-seconds: 600
      demo-otp-enabled: true
      provider: mock
  security:
    jwt-secret: YOUR_JWT_SECRET
  way2api:
    api-key: YOUR_WAY2API_KEY
  razorpay:
    key-id: YOUR_RAZORPAY_KEY_ID
    key-secret: YOUR_RAZORPAY_KEY_SECRET


  twilio:
    account-sid: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    auth-token: YOUR_TWILIO_AUTH_TOKEN
    verify-service-sid: VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


  payu:
    environment: sandbox
    merchant-key: "YOUR_PAYU_MERCHANT_KEY"
    merchant-salt: "YOUR_PAYU_MERCHANT_SALT"
    merchant-id: "YOUR_PAYU_MERCHANT_ID"
    client-id: "YOUR_PAYU_CLIENT_ID"
    client-secret: "YOUR_PAYU_CLIENT_SECRET"
    agent-id: "YOUR_PAYU_AGENT_ID"


  operator-code-mappings:
    AIRTEL: "..."
    JIO: "..."
    VI: "..."


  circle-code-mappings:
    "Bihar and Jharkhand": "..."
spring:
  datasource:
    username: recharge
    password: recharge


recharge:
  mock-execution-status: SUCCESS
  execution-provider: mock
  offer-cache-ttl-seconds: 86400

withdrawal:
    provider-order: razorpay,payu

razorpay:
    payout:
      enabled: true
      key-id: "YOUR_RAZORPAY_PAYOUT_KEY_ID"
      key-secret: "YOUR_RAZORPAY_PAYOUT_KEY_SECRET"
      account-number: "YOUR_RAZORPAYX_ACCOUNT_NUMBER"
      contact-id: "YOUR_RAZORPAY_CONTACT_ID"
      purpose: "payout"
      webhook-secret: "YOUR_RAZORPAY_WEBHOOK_SECRET" 

payu:
    payout:
      enabled: true
      environment: "test"
      auth-base-url: "https://uat-accounts.payu.in"
      api-base-url: "https://uatoneapi.payu.in"
      client-id: "YOUR_PAYU_CLIENT_ID"
      client-secret: "YOUR_PAYU_CLIENT_SECRET"
      payout-merchant-id: "YOUR_PAYU_PAYOUT_MERCHANT_ID"
      scope: "create_payout_transactions"
      webhook-authorization: "YOUR_PAYU_WEBHOOK_AUTHORIZATION" 
