# Canonical mPay public root URL.
# Change this ONE URL to move mPay Web, API, Admin Web and Android together.
MPAY_PUBLIC_ROOT_URL=https://quantaedge.in

# Keep false until a separate public TURN service is provisioned and tested.
# TURN uses direct UDP/TCP; it is not exposed through the Cloudflare HTTP tunnel.
MPAY_TURN_ENABLED=false
