# GitHub Container Registry application images
# main uses latest; the feature helper derives feature-<branch>-latest.
MPAY_BACKEND_IMAGE=ghcr.io/manav326/mpay-backend
MPAY_ADMIN_WEB_IMAGE=ghcr.io/manav326/mpay-admin-web
MPAY_IMAGE_TAG=latest

# Local development
MPAY_LAN_IP=192.168.31.47
MPAY_DB_NAME=recharge
MPAY_DB_USERNAME=recharge
MPAY_DB_PASSWORD=recharge

# Browser-visible API URL used when building the Admin Web image.
# Use the LAN IP locally so the web also works from another device on Wi-Fi.
MPAY_WEB_API_BASE_URL=http://192.168.31.47:8080

# Backend CORS: include local PC, loopback and LAN web origins.
MPAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.31.47:3000

# Production example (uncomment/change when deploying behind Caddy)
# MPAY_PUBLIC_DOMAIN=admin.example.com
# MPAY_WEB_API_BASE_URL=https://admin.example.com
# MPAY_CORS_ALLOWED_ORIGINS=https://admin.example.com

# Rental marketplace platform fee percentage
MPAY_RENTAL_PLATFORM_FEE_PERCENT=10.00
